NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only: generate with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep the same secret across deployments; changing it requires players to verify again.
WALLET_VERIFICATION_SECRET=
# Optional dedicated Solana mainnet RPC. Public providers are the default.
# SOLANA_RPC_URL=https://YOUR_SOLANA_MAINNET_RPC

# Enable only after applying supabase/migrations/202610310001_wallet_holdings.sql.
WALLET_DATABASE_ENABLED=false
# Server-only Supabase secret key (legacy SUPABASE_SERVICE_ROLE_KEY also supported).
SUPABASE_SECRET_KEY=
# Server-only random 32-byte hex secret; Vercel sends it as the cron Bearer token.
CRON_SECRET=
